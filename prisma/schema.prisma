// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 文章所属栏目：学习与输入 / 思考与输出
enum Section {
  LEARNING // 学习与输入
  THINKING // 思考与输出
}

enum CommentStatus {
  VISIBLE
  HIDDEN
}

enum QuestionStatus {
  PENDING // 待审核
  PUBLISHED // 已审核并公开（问题+回复都可见）
  REJECTED // 审核后不公开
}

model Post {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String? // 列表页摘要，留空则自动截取正文
  content   String // WYSIWYG 编辑器产出的 HTML
  coverImage String? // 封面图 URL（Vercel Blob）
  section   Section
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  publishedAt DateTime?

  comments Comment[]
  tags     PostTag[]
  views    PostView[]

  @@index([section, published, publishedAt])
}

// 访客用户：博客门禁系统。name（初始用户名）锁定，displayName（当前显示名）可自行修改。
model Visitor {
  id          String   @id @default(cuid())
  name        String   @unique // 初始用户名：后台添加时填写，锁定不变（后台列表始终显示它）
  displayName String   @default("") // 当前显示名：首页"欢迎 xxx"用，访客可自行修改
  password    String   @unique // 密码：初始为"我是优秀的" + name，访客最多可自行修改 3 次
  changeCount Int      @default(0) // 已修改密码次数，达到上限后不能再改
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  views       PostView[]
  changes     PasswordChangeLog[]
  nameChanges NameChangeLog[]

  @@index([createdAt])
}

// 改名记录：访客修改显示名时写入，通知中心展示
model NameChangeLog {
  id        String   @id @default(cuid())
  visitorId String
  visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  oldName   String // 旧显示名
  newName   String // 新显示名
  read      Boolean  @default(false) // 后台是否已读
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([read])
}

// 文章访问明细：每次刷新文章页记一条
model PostView {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  visitorId String? // 访客登录时记录其 id；管理员访问时为 null
  visitor   Visitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  viewedAt  DateTime @default(now())

  @@index([postId, viewedAt])
  @@index([visitorId, viewedAt])
}

// 密码修改记录：同时作为后台"通知中心"的数据来源
model PasswordChangeLog {
  id          String   @id @default(cuid())
  visitorId   String
  visitor     Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  oldPassword String // 明文记录旧密码
  newPassword String // 明文记录新密码
  read        Boolean  @default(false) // 后台是否已读
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([read])
}

// 标签：相当于每个栏目页下的"文件夹"，对文章进行分类
model Tag {
  id        String   @id @default(cuid())
  name      String
  slug      String
  section   Section
  createdAt DateTime @default(now())

  posts     PostTag[]

  @@unique([slug, section])
}

// 文章-标签多对多关联表
model PostTag {
  postId String
  tagId  String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Comment {
  id        String        @id @default(cuid())
  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId  String? // 回复某条评论时指向父评论，顶级评论为 null
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  children  Comment[]     @relation("CommentReplies")
  nickname  String
  content   String
  status    CommentStatus @default(VISIBLE)
  createdAt DateTime      @default(now())
  ip        String? // 用于简单防刷（限流）

  @@index([postId, status, createdAt])
  @@index([parentId])
}

model Question {
  id          String         @id @default(cuid())
  nickname    String? // 可匿名
  content     String
  reply       String?
  status      QuestionStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  repliedAt   DateTime?
  ip          String?

  @@index([status, createdAt])
}

model Research {
  id            String   @id @default(cuid())
  title         String
  publishedDate DateTime
  journal       String
  createdAt     DateTime @default(now())

  @@index([publishedDate])
}

model AdminSettings {
  id              Int     @id @default(1)
  passwordHash    String?
  heroImage       String?
  heroTitle       String?
  heroSubtitle    String?
  aboutTitle      String?
  aboutParagraph1 String?
  aboutParagraph2 String?
  aboutPhotoUrl   String?
}
