// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 文章所属栏目：学习与思考 / 财经专栏
// THINKING 为历史废弃值（原"思考与输出"），因 Neon 不支持删除枚举值而保留，代码中不使用
enum Section {
  LEARNING // 学习与思考
  FINANCE // 财经专栏
  THINKING // 已废弃
}

enum CommentStatus {
  VISIBLE
  HIDDEN
}

enum QuestionStatus {
  PENDING // 待审核
  PUBLISHED // 已审核并公开（问题+回复都可见）
  REJECTED // 审核后不公开
}

enum NoteStatus {
  PENDING // 待审核
  PUBLISHED // 已审核并公开
  REJECTED // 审核后不公开
}

model Post {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String? // 列表页摘要，留空则自动截取正文
  content   String // WYSIWYG 编辑器产出的 HTML
  coverImage String? // 封面图 URL（Vercel Blob）
  section   Section
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  publishedAt DateTime?

  // 所属文件夹（栏目下的二级分类），可空；文件夹删除后文章保留为未分类
  folderId String?
  folder   Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  comments Comment[]
  tags     PostTag[]
  views    PostView[]

  @@index([section, published, publishedAt])
  @@index([folderId])
}

// 文件夹：栏目（Section）下的二级分类。访客进入栏目页先看到文件夹列表，点击后查看该文件夹下的文章。
model Folder {
  id        String   @id @default(cuid())
  name      String
  slug      String
  section   Section
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts Post[]

  @@unique([slug, section])
  @@index([section])
}

// 访客用户：博客门禁系统。name（初始用户名）锁定，displayName（昵称）可后台设置，默认为用户名。
model Visitor {
  id          String   @id @default(cuid())
  name        String   @unique // 初始用户名：后台添加时填写，锁定不变（后台列表始终显示它）
  displayName String   @default("") // 昵称：留空默认等于用户名
  password    String   @unique // 密码：初始为"我是优秀的" + name，由后台管理
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  views PostView[]
  notes Note[]

  @@index([createdAt])
}

// 文章访问明细：每次刷新文章页记一条
model PostView {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  visitorId String? // 访客登录时记录其 id；管理员访问时为 null
  visitor   Visitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  viewedAt  DateTime @default(now())

  @@index([postId, viewedAt])
  @@index([visitorId, viewedAt])
}

// 标签：相当于每个栏目页下的"文件夹"，对文章进行分类
model Tag {
  id        String   @id @default(cuid())
  name      String
  slug      String
  section   Section
  createdAt DateTime @default(now())

  posts     PostTag[]

  @@unique([slug, section])
}

// 文章-标签多对多关联表
model PostTag {
  postId String
  tagId  String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Comment {
  id        String        @id @default(cuid())
  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId  String? // 回复某条评论时指向父评论，顶级评论为 null
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  children  Comment[]     @relation("CommentReplies")
  nickname  String
  content   String
  status    CommentStatus @default(VISIBLE)
  createdAt DateTime      @default(now())
  ip        String? // 用于简单防刷（限流）

  @@index([postId, status, createdAt])
  @@index([parentId])
}

model Question {
  id          String         @id @default(cuid())
  nickname    String? // 可匿名
  content     String
  reply       String?
  status      QuestionStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  repliedAt   DateTime?
  ip          String?

  @@index([status, createdAt])
}

// 留言墙纸条：访客或博主添加。authorType 区分来源（VISITOR/ADMIN），
// 博主添加的纸条前台显示时带加粗边框标记。
model Note {
  id         String     @id @default(cuid())
  authorType String // "VISITOR" 或 "ADMIN"
  visitorId  String?
  visitor    Visitor?   @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  nickname   String? // 可匿名
  content    String // 几句话的感悟，≤ 200 字
  color      String // 淡色系配色 key（pink/yellow/green/blue/purple/orange/mint）
  shape      String // rectangle / square / circle
  posX       Float? // 墙上的水平位置（百分比 0-100）
  posY       Float? // 墙上的垂直位置（百分比 0-100）
  status     NoteStatus @default(PENDING)
  likes      Int        @default(0) // 点赞数（冗余计数，与 NoteLike 记录保持一致）
  createdAt  DateTime   @default(now())
  ip         String? // 用于简单防刷（限流）

  likesLog NoteLike[]

  @@index([status, createdAt])
  @@index([visitorId])
}

// 留言墙点赞记录：同一 IP 对同一张纸条只能赞一次（点赞/取消点赞都记录在此去重）
model NoteLike {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  ip        String
  createdAt DateTime @default(now())

  @@unique([noteId, ip])
  @@index([noteId])
}

model Research {
  id            String   @id @default(cuid())
  title         String
  publishedDate DateTime
  journal       String
  createdAt     DateTime @default(now())

  @@index([publishedDate])
}

model AdminSettings {
  id              Int     @id @default(1)
  passwordHash    String?
  heroImage       String?
  heroTitle       String?
  heroSubtitle    String?
  aboutTitle      String?
  aboutParagraph1 String?
  aboutParagraph2 String?
  aboutPhotoUrl   String?
}
